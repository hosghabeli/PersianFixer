{
  "manifest_version": 3,
  "name": "PersianFixer: اصلاح هوشمند فارسی و راست‌چین چت‌بات‌های هوش مصنوعی",
  "short_name": "PersianFixer",
  "version": "1.0.2",
  "description": "راست‌چین‌سازی هوشمند (RTL)، اصلاح جداول و بلاک‌های متنی/مارک‌داون و اعمال فونت وزیرمتن در وب‌سایت‌ها و چت‌بات‌های هوش مصنوعی (ChatGPT, Claude, Gemini, DeepSeek, Perplexity و...).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "تنظیمات PersianFixer"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://gemini.google.com/*",
    "*://aistudio.google.com/*",
    "*://chat.deepseek.com/*",
    "*://*.deepseek.com/*",
    "*://perplexity.ai/*",
    "*://*.perplexity.ai/*",
    "*://poe.com/*",
    "*://*.poe.com/*",
    "*://copilot.microsoft.com/*",
    "*://*.copilot.microsoft.com/*",
    "*://*.bing.com/*",
    "*://edgeservices.bing.com/*",
    "*://chat.mistral.ai/*",
    "*://groq.com/*",
    "*://*.groq.com/*",
    "*://v0.dev/*",
    "*://*.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://aistudio.google.com/*",
        "*://chat.deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://perplexity.ai/*",
        "*://*.perplexity.ai/*",
        "*://poe.com/*",
        "*://*.poe.com/*",
        "*://copilot.microsoft.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://*.bing.com/*",
        "*://edgeservices.bing.com/*",
        "*://chat.mistral.ai/*",
        "*://groq.com/*",
        "*://*.groq.com/*",
        "*://v0.dev/*",
        "*://*.huggingface.co/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Vazirmatn.ttf",
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-active": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "فعال/غیرفعال کردن سریع PersianFixer در سایت فعلی"
    }
  }
}
